#!/usr/bin/env python3
"""
Хук PreToolUse воркера на agy (Antigravity CLI): переводит вызов agy на язык
worker-guard и bash-pitfalls и возвращает их ответ в форме, которую ждёт agy.

ЗАЧЕМ ПЕРЕВОДЧИК, А НЕ ВТОРАЯ ОГРАДА. Список запретов один — worker-guard; две
копии разошлись бы при первой правке. agy отличается только формой: вход —
{"toolCall": {"name", "args"}, "cwd"} в camelCase, ответ — JSON на stdout
{"decision": "allow"|"deny", "reason"}, а не код 2 (проверено на agy 1.5.16,
26.11.2026: deny останавливает вызов, причину агент видит дословно).

Инструменты agy и ключи аргументов (тот же запуск): run_command{CommandLine,
Cwd}, write_file{Path, Content}, edit_file{Path, Target, Replacement},
read_file{Path}. Остальные имена взяты из строк бинарника — путь ищем по всем
ключам, похожим на путь, чтобы новый инструмент правки не прошёл мимо ограды.

ОТКАЗ ПО УМОЛЧАНИЮ. Упала ограда или вход не разобран — deny: ложный отказ
воркер обойдёт через оркестратора, ложный пропуск в режиме без вопросов
не отменить.
"""
import json
import os
import subprocess
import sys

HOME = os.path.expanduser("~")
GUARD = os.environ.get("ANCHOR_GUARD", os.path.join(HOME, ".local", "bin", "anchor-worker-guard"))
PITFALLS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bash-pitfalls")

SHELL = {"run_command", "send_command_input"}
WRITE = {"write_file", "create_file", "edit_file", "write_to_file", "replace_file_content",
         "multi_replace_file_content", "delete_file", "move_file", "rename_file"}
PATH_KEYS = ("Path", "TargetFile", "AbsolutePath", "FilePath", "File", "SearchPath",
             "DirectoryPath", "Source", "SourcePath", "Destination", "DestinationPath", "NewPath")


def answer(decision: str, reason: str = "") -> None:
    print(json.dumps({"decision": decision, **({"reason": reason} if reason else {})}, ensure_ascii=False))
    sys.exit(0)


def ask(script: str, payload: dict) -> None:
    """Код 2 — отказ с причиной из stderr; 0 — дальше; прочее — отказ: ограда сломана."""
    if not os.access(script, os.X_OK):
        return
    r = subprocess.run([script], input=json.dumps(payload), capture_output=True, text=True, timeout=25)
    if r.returncode == 2:
        answer("deny", r.stderr.strip() or "worker-guard: отказ")
    if r.returncode != 0:
        answer("deny", f"ограда {os.path.basename(script)} упала (код {r.returncode}): "
                       f"{r.stderr.strip()[-300:]} — напиши оркестратору")


def main() -> None:
    try:
        data = json.load(sys.stdin)
        call = data["toolCall"]
        name, args = call.get("name", ""), call.get("args") or {}
    except Exception as e:
        answer("deny", f"agy-hook: вход не разобран ({e}) — напиши оркестратору")
    cwd = args.get("Cwd") or data.get("cwd") or os.getcwd()

    if name in SHELL:
        cmd = args.get("CommandLine") or args.get("Input") or ""
        payload = {"tool_name": "Bash", "tool_input": {"command": cmd}, "cwd": cwd}
        ask(GUARD, payload)
        if name == "run_command":
            ask(PITFALLS, payload)
    else:
        tool = "Write" if name in WRITE else "Read"
        for k in PATH_KEYS:
            p = args.get(k)
            if isinstance(p, str) and p:
                ask(GUARD, {"tool_name": tool, "tool_input": {"file_path": os.path.join(cwd, p)}, "cwd": cwd})
    answer("allow")


if __name__ == "__main__":
    main()
