#!/usr/bin/env python3
"""
Ограда воркера anchor: хук PreToolUse для сессий без вопросов о разрешении.

ЗАЧЕМ. Воркер запускают с ключом --dangerously-skip-permissions, чтобы он не
простаивал на каждом «можно?» (03.10.2026 воркер стоял на вопросе, пока его
не заметили; 14.10.2026 — переход с --permission-mode bypassPermissions на
этот ключ, решение владельца).
Но правило «необратимое — только с „да“ человека» от этого не отменяется. В
режиме без вопросов его держит этот хук: хуки срабатывают и тогда, когда
разрешения не спрашиваются. Отказ — код 2 и причина в stderr: Claude видит её
и идёт другим путём или пишет оркестратору.

ЧТО ЗАКРЫТО — только необратимое и чужое, не обычная работа:
- релизы, удаление репозиториев и веток на сервере;
- push в main/master и push --force без --force-with-lease;
- секреты (~/.secrets, .env с ключами) и чтение копий базы;
- деплой в прод, sudo, установка системных пакетов;
- закрытие чужих панелей и деревьев herdr, удаление задач beads;
- rm -rf вне своего дерева;
- pkill/killall (16.10.2026 воркер убил по шаблону чужие прогоны тестов);
- правка файлов в ~/Projects вне своих деревьев (<якорь>-back, <якорь>-front).

СЛИЯНИЕ PR И МИГРАЦИИ ВОРКЕРУ ОТКРЫТЫ (решение владельца 18.10.2026): воркер,
сдавший зелёный PR, сам вливает свежий main, гоняет тесты и сливает; миграцию
применяет после копии базы (scripts/db_backup.sh) через сессионный порт 5432.
Ограда этот порядок проверить не может — его держит постановка воркера
(anchor-queue, prompt_text).

ДЕПЛОЙ ПО СПИСКУ (решение владельца 18.10.2026). Воркер, слив PR, упирался в
запрет `railway up` для telegram-bot — сервиса, который сам из main не
выкатывается, — и выкат ждал человека. Теперь `railway up <дерево> --service S`
пропускается, если S есть в ~/.anchor/deploy_allow (по сервису в строке, его
ведёт владелец) и дерево стоит ровно на origin/main без правок: выкатить можно
только уже слитое. Переменные прода, vercel, другие сервисы и выкат ветки
закрыты по-прежнему; сам список воркеру не записать (WRITE_DENY, BASH_DENY).

Список — регулярные выражения ниже. Ложный отказ дешевле, чем ложный пропуск:
воркер, упёршийся в ограду, напишет оркестратору, а оркестратор сделает это
сам или спросит человека.
"""
import json
import os
import re
import subprocess
import sys

BASH_DENY = [
    (r"\banchor-queue\s+run\b", "запуск воркеров из очереди — оркестратор"),
    (r"\bgh\s+release\s+(create|delete|edit)\b", "релиз — решение человека"),
    (r"\bgh\s+repo\s+(delete|archive|rename|edit)\b", "репозиторий — решение человека"),
    (r"\bgh\s+api\b.*-X\s*(DELETE|PUT|PATCH)", "правка GitHub через API — решение человека"),
    (r"\bgit\s+push\b[^|;&]*(\s|:)(main|master)(\s|$|[;&|])", "push в main/master — только с «да» человека"),
    (r"\bgit\s+push\b[^|;&]*(--force(?!-with-lease)|\s-f\b)", "push --force без --force-with-lease"),
    (r"\bgit\s+push\b[^|;&]*(--delete|\s:[\w./-]+)", "удаление ветки на сервере"),
    (r"\.secrets\b", "секреты — только у оркестратора"),
    (r"db_full_backup|(^|[\s/])backups/\S*\.sql", "копии базы содержат данные клиентов — только у оркестратора"),
    # pg_restore поверх рабочей базы необратим — его по-прежнему делает человек.
    (r"\bpg_restore\b", "восстановление базы из копии — решение человека"),
    (r"\b(railway|vercel)\b[^|;&]*(\s)(up|deploy|--prod|redeploy|variables\s+set)(\s|$)", "деплой и переменные прода — решение человека"),
    # 18.10.2026: `railway variables --set A=1` проходил — шаблон выше знал только
    # форму «variables set». Любая запись и удаление переменных — человеку.
    (r"\b(railway|vercel)\b[^|;&]*\b(variables?|env)\b[^|;&]*(--set|\s(set|add|rm|remove|delete|unset)\b)", "переменные прода — решение человека"),
    (r"(^|[;&|]\s*)sudo\b", "sudo"),
    (r"\b(apt|apt-get|dnf|yum|snap)\s+(install|remove|purge)\b", "системные пакеты"),
    (r"\bherdr\s+(workspace|pane|tab|worktree)\s+(close|remove|delete|move)\b", "раскладку herdr меняет оркестратор"),
    (r"\bherdr\s+agent\s+(prompt|start|stop)\b", "другими агентами управляет оркестратор"),
    (r"\bbd\s+delete\b", "удалять задачи beads — оркестратор"),
    (r"\bgit\s+worktree\s+(remove|prune)\b", "деревья убирает оркестратор"),
    (r"\bgit\s+branch\s+-[dD]\b", "удаление веток — оркестратор"),
    # Только запись в эти файлы, а не любое упоминание: 18.10.2026 воркер получил
    # отказ на worker-state, потому что в тексте причины встретилось имя ограды.
    (r"(>|\btee\b|\bsed\s+-i|\bcp\b|\bmv\b|\brm\b|\bln\b|\bchmod\b)[^|;&]*(worker-guard|settings(\.local)?\.json|\.claude/hooks|\.claude\.json)", "ограду и настройки Claude правит только оркестратор"),
    (r"(>|\btee\b|\bsed\s+-i|\bcp\b|\bmv\b|\brm\b|\bln\b|\bchmod\b)[^|;&]*deploy_allow", "список разрешённого деплоя ведёт только владелец"),
    (r"(^|[;&|]\s*|\s)(pkill|killall)\b", "pkill/killall бьют по шаблону и задевают чужие процессы — останавливай свой процесс по pid"),
    (r"\bcrontab\b|\bsystemctl\s+(start|stop|restart|enable|disable)\b", "службы машины"),
]

# Правка ограды и настроек Claude: из режима без вопросов воркер иначе мог бы
# снять хук с себя — настройки Claude Code перечитывает на ходу.
WRITE_DENY = [
    (r"(^|/)\.anchor/deploy_allow$", "список разрешённого деплоя ведёт только владелец"),
    (r"worker-guard$", "ограду правит только оркестратор"),
    (r"(^|/)\.claude/(settings(\.local)?\.json|hooks/)", "настройки Claude правит только оркестратор"),
    (r"(^|/)\.claude\.json$", "настройки Claude правит только оркестратор"),
]

READ_DENY = [
    (r"/\.secrets(/|$)", "секреты — только у оркестратора"),
    (r"(^|/)backups/[^/]*\.(sql|dump|gz)$|db_full_backup", "копии базы содержат данные клиентов — только у оркестратора"),
    (r"(^|/)\.env(\.(?!example$|sample$|template$)[\w-]+)?$", ".env с ключами — только у оркестратора"),
]


def deny(reason: str) -> None:
    print(f"worker-guard: отказ — {reason}. Если это нужно для темы, напиши "
          f"оркестратору в итоге или в якорь, он сделает сам или спросит человека.",
          file=sys.stderr)
    sys.exit(2)


def rm_outside_tree(cmd: str, cwd: str) -> bool:
    for m in re.finditer(r"\brm\s+(-\w*r\w*f\w*|-\w*f\w*r\w*|-r\s+-f|-f\s+-r)\s+([^;&|]+)", cmd):
        for target in m.group(2).split():
            if target.startswith("-"):
                continue
            path = os.path.realpath(os.path.join(cwd, os.path.expanduser(target)))
            root = os.path.realpath(cwd)
            if path == "/" or not (path == root or path.startswith(root + os.sep)):
                return True
    return False


def _корень_дерева(cwd: str) -> str:
    """
    Корень рабочего дерева, а не текущий каталог сессии.

    18.10.2026 воркер сделал cd в подкаталог src/…, и «своим деревом» для ограды
    стал этот подкаталог: запись в tests/ того же дерева получила «правка вне
    своих деревьев», воркер встал на полчаса. Корень берём у git
    (--show-toplevel); вне git — сам cwd, как было.
    """
    try:
        r = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return os.path.realpath(r.stdout.strip())
    except Exception:
        pass
    return os.path.realpath(cwd)


def edit_outside_trees(path: str, cwd: str) -> bool:
    """
    Запись в ~/Projects вне своих деревьев. Свои: рабочее дерево (cwd) и
    соседи с тем же якорем — wt/<якорь>-back и wt/<якорь>-front. Вне ~/Projects
    (/tmp, ~/.claude/plans и т.п.) не ограничиваем: там чужой работы нет.
    """
    projects = os.path.realpath(os.path.expanduser("~/Projects"))
    target = os.path.realpath(os.path.join(cwd, path))
    if not target.startswith(projects + os.sep):
        return False
    root = _корень_дерева(cwd)
    свои = [root]
    имя = os.path.basename(root)
    for хвост in ("-back", "-front"):
        if имя.endswith(хвост):
            якорь = имя[: -len(хвост)]
            родитель = os.path.dirname(root)
            свои += [os.path.join(родитель, якорь + "-back"), os.path.join(родитель, якорь + "-front")]
    return not any(target == r or target.startswith(r + os.sep) for r in свои)


DEPLOY_ALLOW_FILE = os.path.expanduser("~/.anchor/deploy_allow")
DEPLOY_CMD = re.compile(
    r"^\s*(?:cd\s+\S+\s*&&\s*)?railway\s+up\s+(?P<path>\S+)\s+(?P<flags>(?:--?[\w-]+(?:\s+(?![-])\S+)?\s*)+)$")


def allowed_services() -> set[str]:
    try:
        with open(DEPLOY_ALLOW_FILE, encoding="utf-8") as f:
            return {line.strip() for line in f if line.strip() and not line.startswith("#")}
    except OSError:
        return set()


def _git(tree: str, *args: str) -> str:
    r = subprocess.run(["git", "-C", tree, *args], capture_output=True, text=True, timeout=20)
    return r.stdout.strip() if r.returncode == 0 else ""


def deploy_allowed(cmd: str, cwd: str) -> bool:
    """
    `railway up <tree> --service S [--path-as-root] [--detach]` одной командой.

    Пропускаем, только если S в списке владельца, а дерево — чистый origin/main:
    HEAD совпадает с origin/main после fetch и нет незакоммиченных правок. Любая
    цепочка (`;`, `|`, второе `&&`) — отказ: в неё можно спрятать что угодно.
    """
    if re.search(r"[;|`$<>]", cmd) or cmd.count("&&") > 1:
        return False
    m = DEPLOY_CMD.match(cmd)
    if not m:
        return False
    flags = m.group("flags").split()
    if "--service" not in flags or flags.count("--service") != 1:
        return False
    i = flags.index("--service")
    service = flags[i + 1] if i + 1 < len(flags) else ""
    rest = flags[:i] + flags[i + 2:]
    if service not in allowed_services() or any(f not in ("--path-as-root", "--detach") for f in rest):
        return False
    base = cwd
    cd = re.match(r"^\s*cd\s+(\S+)\s*&&", cmd)
    if cd:
        base = os.path.join(cwd, os.path.expanduser(cd.group(1)))
    tree = os.path.realpath(os.path.join(base, os.path.expanduser(m.group("path"))))
    if not os.path.isdir(tree):
        return False
    subprocess.run(["git", "-C", tree, "fetch", "-q", "origin", "main"], capture_output=True, timeout=60)
    head, main = _git(tree, "rev-parse", "HEAD"), _git(tree, "rev-parse", "origin/main")
    dirty = subprocess.run(["git", "-C", tree, "diff", "--quiet", "HEAD"], capture_output=True).returncode != 0
    return bool(head) and head == main and not dirty


def main() -> None:
    try:
        data = json.load(sys.stdin)
    except Exception:
        return
    tool = data.get("tool_name", "")
    inp = data.get("tool_input") or {}
    cwd = data.get("cwd") or os.getcwd()

    if tool == "Bash":
        cmd = inp.get("command", "")
        if deploy_allowed(cmd, cwd):
            return
        for pattern, reason in BASH_DENY:
            if re.search(pattern, cmd):
                deny(reason)
        if rm_outside_tree(cmd, cwd):
            deny("rm -rf вне своего дерева")
    elif tool in ("Read", "Edit", "Write", "NotebookEdit", "Grep", "Glob"):
        path = inp.get("file_path") or inp.get("notebook_path") or inp.get("path") or ""
        path = os.path.expanduser(path)
        for pattern, reason in READ_DENY:
            if re.search(pattern, path):
                deny(reason)
        if tool in ("Edit", "Write", "NotebookEdit"):
            for pattern, reason in WRITE_DENY:
                if re.search(pattern, path):
                    deny(reason)
            if path and edit_outside_trees(path, cwd):
                deny("правка вне своих деревьев — чужая работа")


if __name__ == "__main__":
    main()
