#!/usr/bin/env python3
"""
anchor-status — одна таблица вместо трёх источников: кто из воркеров что
держит и что у него готово к сдаче.

ЗАЧЕМ. `herdr agent list` отвечает на вопрос «кто есть», и отвечает верно. Но
оркестратору нужен другой: «у кого лежит работа, которую я ещё не забрал».
09.10.2026 работа трижды находилась в дереве ПОСЛЕ того, как тема считалась
закрытой: воркер доделал и не сказал, межсессионное сообщение не дошло,
оркестратор видел «idle» и шёл дальше. Один раз это была готовая правка,
найденная случайно при уборке деревьев.

Разойтись могут именно три источника, и порознь каждый говорит правду:
  herdr   — какие панели живы и чем заняты
  git     — что лежит в деревьях: несливённое и незакоммиченное
  трекер  — в каком состоянии тикет (если он подключён, см. ниже)

Скрипт их сводит. Ничего не меняет: только читает.

КОГДА СМОТРЕТЬ
  — перед закрытием темы (шаг 4 из пяти: «дерево убрано»);
  — раз в час-полтора работы с несколькими воркерами;
  — всегда, когда кажется, что воркер молчит.

Запуск:  anchor-status            из каталога репозитория
         anchor-status --wt ПУТЬ  если деревья лежат не рядом

ТИКЕТ. Код тикета ищется в имени ветки, а если его там нет — в имени воркера,
по шаблону ANCHOR_TICKET_RE (по умолчанию — код вида ABC-123, ABC2-45: латинские
заглавные, дефис, цифры, отдельным словом). Кодов в ветке бывает несколько
(TKT-1637-SUB-036-…) — берётся первый: имя ветки начинается с кода внешнего
трекера, а следующие коды — подтемы якоря (их разбирает хук старта).
Трекер с другими кодами — свой шаблон: ANCHOR_TICKET_RE='#[0-9]+'.

Состояние тикета спрашивается командой ANCHOR_TICKET_STATUS_CMD: {code}
подставляется кодом, первая строка вывода — состояние. Например:
  ANCHOR_TICKET_STATUS_CMD='jira issue view {code} --plain --columns status'
Без неё — каталог get-tickets в репозитории (EvaTeam), если он есть;
нет ни того, ни другого — колонка показывает только код.
"""
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

DEFAULT_TICKET_RE = r"(?<![A-Za-z0-9])[A-Z][A-Z0-9]*-\d+(?![A-Za-z0-9])"


def run(cmd, cwd=None, timeout=20):
    try:
        r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                           timeout=timeout)
        return r.stdout.strip()
    except Exception:
        return ""


def herdr_agents():
    """Живые панели: имя → каталог. Пустой словарь, если herdr недоступен."""
    out = run(["herdr", "agent", "list"])
    if not out:
        return {}
    try:
        d = json.loads(out)
    except json.JSONDecodeError:
        return {}
    rows = d.get("result", {}).get("agents", d) if isinstance(d, dict) else d
    res = {}
    for a in rows if isinstance(rows, list) else []:
        name = a.get("name")
        if name:
            res[name] = {"cwd": a.get("cwd", ""),
                         "status": a.get("agent_status", "?")}
    return res


def tree_state(path):
    """Что лежит в дереве: несливённое и незакоммиченное.

    Несливённое считается относительно origin/main, а не локального main:
    локальный может опережать удалённый на несколько слияний, и тогда
    «не слито 0» означало бы лишь «я это уже забрал», а не «оно уехало».
    """
    branch = run(["git", "branch", "--show-current"], cwd=path)
    unmerged = run(["git", "log", "origin/main..HEAD", "--oneline"], cwd=path)
    dirty = run(["git", "status", "--porcelain"], cwd=path)
    # Файлы роли и выгрузки эксперта за работу не считаем: они живут в дереве
    # по замыслу и мусором не являются.
    skip = re.compile(r"CLAUDE\.local\.md|\.xlsx$|\.json$")
    dirty_n = len([l for l in dirty.splitlines() if l and not skip.search(l)])
    return {
        "branch": branch or "—",
        "unmerged": len(unmerged.splitlines()) if unmerged else 0,
        "dirty": dirty_n,
    }


def ticket_code(branch, worker):
    """Код тикета: первый в имени ветки, иначе в имени воркера; пусто, если нет."""
    pattern = re.compile(os.environ.get("ANCHOR_TICKET_RE") or DEFAULT_TICKET_RE)
    for text in (branch, worker.upper()):
        found = pattern.findall(text or "")
        if found:
            first = found[0]
            return first if isinstance(first, str) else first[0]
    return ""


def ticket_status(code, gt_dir):
    """Состояние тикета в трекере. Пусто, если трекер не подключён или не ответил."""
    if not code:
        return ""
    cmd = os.environ.get("ANCHOR_TICKET_STATUS_CMD")
    if cmd:
        out = run([part.replace("{code}", code) for part in shlex.split(cmd)], timeout=25)
        return out.splitlines()[0].strip() if out else ""
    if not gt_dir.exists():
        return ""
    code_py = (
        "import os,sys;"
        "from dotenv import load_dotenv;"
        "load_dotenv('.env');sys.path.insert(0,'.');"
        "from main import rpc;"
        f"t=rpc('CmfTask.list', code='{code}', fields=['cache_status_type']);"
        "print(t[0]['cache_status_type'] if t else '')"
    )
    return run([sys.executable, "-c", code_py], cwd=gt_dir, timeout=25)


def main():
    repo = Path.cwd()
    wt_root = None
    if "--wt" in sys.argv:
        wt_root = Path(sys.argv[sys.argv.index("--wt") + 1])
    else:
        guess = repo.parent / (repo.name.split("-")[0] + "-wt")
        wt_root = guess if guess.exists() else repo.parent

    gt_dir = repo / "get-tickets"
    agents = herdr_agents()

    rows = []
    seen_paths = set()

    for name, info in sorted(agents.items()):
        cwd = info["cwd"]
        if not cwd or not Path(cwd).exists() or cwd == str(repo):
            continue
        seen_paths.add(cwd)
        st = tree_state(cwd)
        code = ticket_code(st["branch"], name)
        rows.append({
            "worker": name,
            "branch": st["branch"],
            "unmerged": st["unmerged"],
            "dirty": st["dirty"],
            "status": info["status"],
            "ticket": code,
        })

    # Деревья без воркера: работа в них есть, а сказать о ней некому.
    orphans = []
    if wt_root.exists():
        for d in sorted(wt_root.iterdir()):
            if not d.is_dir() or str(d) in seen_paths:
                continue
            if not (d / ".git").exists():
                continue
            st = tree_state(d)
            if st["unmerged"] or st["dirty"]:
                orphans.append({"path": d.name, **st})

    if not rows and not orphans:
        print("Воркеров нет, деревьев с работой нет.")
        return

    # Статусы тикетов спрашиваем только там, где есть что забирать: запрос
    # к трекеру не быстрый, а для пустых деревьев ответ ничего не меняет.
    for r in rows:
        if r["unmerged"] or r["dirty"]:
            r["ticket_status"] = ticket_status(r["ticket"], gt_dir)
        else:
            r["ticket_status"] = ""

    w = max([len(r["worker"]) for r in rows] + [12])
    b = max([len(r["branch"][:26]) for r in rows] + [10])
    print(f"{'воркер':<{w}}  {'ветка':<{b}}  не слито  не закоммич  состояние  тикет")
    print("─" * (w + b + 44))
    for r in rows:
        mark = "←" if (r["unmerged"] or r["dirty"]) else " "
        tk = f"{r['ticket']} {r['ticket_status']}".strip()
        print(f"{r['worker']:<{w}}  {r['branch'][:26]:<{b}}  "
              f"{r['unmerged']:>8}  {r['dirty']:>11}  {r['status']:<9}  {tk} {mark}")

    if orphans:
        print()
        print("ДЕРЕВЬЯ БЕЗ ВОРКЕРА — работа есть, сказать о ней некому:")
        for o in orphans:
            print(f"  {o['path']:<30} не слито {o['unmerged']}, "
                  f"не закоммичено {o['dirty']}")

    pending = [r for r in rows if r["unmerged"]]
    if pending:
        print()
        print(f"ЗАБРАТЬ: {', '.join(r['worker'] for r in pending)}")


if __name__ == "__main__":
    main()
