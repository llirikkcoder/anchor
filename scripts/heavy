#!/bin/sh
# heavy <команда…> — тесты и сборка через общую очередь сервера.
#
# ЗАЧЕМ (03.10.2026). Десять воркеров одновременно гоняли pytest, vitest и
# сборку: 4 ядра в 100%, 7,9 ГБ памяти кончились, ядро 17 раз запускало
# OOM-killer и убивало в том числе ботов. Сами воркеры лёгкие (~300 МБ),
# тяжёлые — их проверки. Очередь пускает не больше HEAVY_SLOTS команд разом
# (по умолчанию 1: при трёх воркерах две параллельные проверки давали пики 97%), остальные ждут свободного места, а не падают.
#
#   heavy .venv/bin/python -m pytest tests -q
#   heavy node_modules/.bin/vitest run --maxWorkers=2
#   heavy npm run build
#
# Место держится, пока команда жива: замок наследует сама команда через exec,
# поэтому ни убитый процесс, ни Ctrl+C не оставляют места занятым навсегда.
# Команды идут с nice 10: живые боты и сессии важнее фоновых проверок.

N=${HEAVY_SLOTS:-1}
D=/tmp/heavy-locks
mkdir -p "$D" 2>/dev/null
[ $# -gt 0 ] || { echo "heavy: какую команду запустить?" >&2; exit 2; }

said=0
while :; do
  i=1
  while [ "$i" -le "$N" ]; do
    exec 9>"$D/slot$i"
    if flock -n 9; then
      [ "$said" = 1 ] && echo "heavy: место $i свободно, запускаю" >&2
      exec nice -n 10 "$@"
    fi
    exec 9>&-
    i=$((i + 1))
  done
  if [ "$said" = 0 ]; then
    echo "heavy: заняты все $N места (тесты/сборка других воркеров) — жду очереди" >&2
    said=1
  fi
  sleep 3
done
