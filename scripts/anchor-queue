#!/usr/bin/env python3
"""
anchor-queue — очередь запуска тем с потолком числа воркеров.

ЗАЧЕМ (03.10.2026). Десять воркеров разом на 4 ядрах и 8 ГБ: OOM-killer 17
раз, убиты соседние сервисы. Потолок нашёлся замером — три воркера, — но
держала его память оркестратора: «запущу следующую, когда кто-то закончит».
Намерение механизмом не является. Здесь потолок держит очередь: тема ждёт в
каталоге, пока активных воркеров меньше ANCHOR_MAX.

Без демона: `run` зовёт оркестратор в фоне, и он выходит, когда очередь пуста.
Второй `run` при живом первом сразу выходит — первый и так подберёт новое.

  anchor-queue add <тема.json>     поставить в очередь (описание — ниже)
  anchor-queue list                что ждёт, что запущено, что не встало
  anchor-queue run                 запускать, пока очередь не опустеет
  anchor-queue run --once          запустить одну (дождавшись места) и выйти —
                                   оркестратору, чтобы сразу поставить ожидание
                                   `worker-done --wait <дерево>` на запущенного

Активный воркер — агент herdr с именем на ANCHOR_WORKER_PREFIX (по умолчанию
«w-»), в дереве которого нет свежего .anchor/done.json. Головы и оркестратор
префикса не носят и в счёт не идут. Сдавший работу воркер стоит idle и
процессор не ест — потолок по процессору, а не по памяти (см. SKILL).

ANCHOR_MAX        потолок (по умолчанию 3 — замер на 4 ядрах / 8 ГБ)
ANCHOR_QUEUE_DIR  каталог очереди (по умолчанию ~/.anchor/queue)
ANCHOR_POLL       пауза между проверками места, с (по умолчанию 60)
ANCHOR_GUARD      ограда воркера (по умолчанию ~/.local/bin/anchor-worker-guard);
                  нет ограды — нет запуска: --dangerously-skip-permissions без неё запрещён

Описание темы (JSON, пример — templates/topic.example.json):
  anchor   id якоря                                   обязательно
  label    подпись вкладки                            по умолчанию — anchor
  name     имя агента                                 по умолчанию w-<anchor>
  trees    [{repo, branch, path, base}] — первое дерево рабочее (в нём агент),
           остальные идут в additionalDirectories     обязательно
  prompt | prompt_file   постановка                   обязательно
  beads_dir              по умолчанию <repo первого дерева>/.beads, если есть
  links    {"node_modules": "/путь"} — ссылки в рабочее дерево
  disable_plugins        какие плагины выключить (по умолчанию браузер и Telegram)
  kind     claude | codex | agy — какой агент работает (по умолчанию claude). Codex:
           роль в AGENTS.override.md, запуск ключами из ~/.anchor/codex/<имя>.sh
           (MCP выключены, окружение, ограда хуком);
           модель — codex_model или ANCHOR_CODEX_MODEL, глубина —
           codex_effort или ANCHOR_CODEX_EFFORT (пусто — из ~/.codex/config.toml).
           agy (Antigravity CLI): роль в GEMINI.md, ограда в .agents/hooks.json
           (scripts/agy-hook), запуск из ~/.anchor/agy/<имя>.sh; модель — agy_model
           или ANCHOR_AGY_MODEL, глубина — agy_effort или ANCHOR_AGY_EFFORT
  orchestrator           имя оркестратора в herdr (по умолчанию ANCHOR_ORCHESTRATOR,
                         иначе имя агента в панели, откуда позвали очередь; агента
                         без имени очередь не запустит — см. SKILL, «Воркер знает,
                         кто его оркестратор»)
"""
import datetime
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import tomllib

HOME = os.path.expanduser("~")
QDIR = os.environ.get("ANCHOR_QUEUE_DIR", os.path.join(HOME, ".anchor", "queue"))
MAX = int(os.environ.get("ANCHOR_MAX", "3"))
POLL = float(os.environ.get("ANCHOR_POLL", "60"))
PREFIX = os.environ.get("ANCHOR_WORKER_PREFIX", "w-")
GUARD = os.environ.get("ANCHOR_GUARD", os.path.join(HOME, ".local", "bin", "anchor-worker-guard"))
HERE = os.path.dirname(os.path.realpath(__file__))
PLUGINS_OFF = ["chrome-devtools-mcp@claude-plugins-official", "telegram@claude-plugins-official"]


class Fail(Exception):
    pass


def log(msg: str) -> None:
    print(f"{datetime.datetime.now():%H:%M:%S} {msg}", flush=True)


def sh(*cmd: str, check: bool = True) -> str:
    r = subprocess.run(cmd, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise Fail(f"{' '.join(cmd[:4])}…: {(r.stderr or r.stdout).strip()[:300]}")
    return r.stdout


def herdr_json(*args: str) -> dict:
    out = sh("herdr", *args)
    try:
        return json.loads(out)["result"]
    except Exception:
        raise Fail(f"herdr {' '.join(args[:2])}: непонятный ответ {out[:200]}")


def dirs() -> dict:
    d = {k: os.path.join(QDIR, k) for k in ("pending", "started", "failed")}
    for p in d.values():
        os.makedirs(p, exist_ok=True)
    return d


# --- описание темы --------------------------------------------------------------

def load_topic(path: str) -> dict:
    try:
        t = json.load(open(path))
    except Exception as e:
        raise Fail(f"{path}: не JSON ({e})")
    # Префикс bd бывает с дефисами (haq-ai-concept-t2cx): bd берёт его из имени каталога.
    if not re.fullmatch(r"[a-z][a-z0-9-]*-[a-z0-9]{3,8}(\.[0-9]+)?", t.get("anchor", "")):
        raise Fail("anchor: нужен id якоря beads")
    if not t.get("trees"):
        raise Fail("trees: нужно хотя бы одно дерево")
    for tr in t["trees"]:
        for k in ("repo", "branch", "path"):
            if not tr.get(k):
                raise Fail(f"trees: у дерева нет {k}")
        if tr["branch"] in ("main", "master"):
            raise Fail("trees: тему не ведут в main")
        if not os.path.isdir(os.path.join(tr["repo"], ".git")):
            raise Fail(f"trees: {tr['repo']} — не основное дерево репозитория")
    if not (t.get("prompt") or t.get("prompt_file")):
        raise Fail("нужна постановка: prompt или prompt_file")
    if t.get("prompt_file") and not os.path.isfile(t["prompt_file"]):
        raise Fail(f"prompt_file: нет {t['prompt_file']}")
    t.setdefault("kind", "claude")
    if t["kind"] not in ("claude", "codex", "agy"):
        raise Fail(f"kind: {t['kind']} — бывает claude, codex или agy")
    t.setdefault("name", PREFIX + t["anchor"].replace(".", "-"))
    t.setdefault("label", t["anchor"])
    return t


# --- счёт активных --------------------------------------------------------------

def done_fresh(tree: str) -> bool:
    try:
        dn = json.load(open(os.path.join(tree, ".anchor", "done.json")))
    except Exception:
        return False
    try:
        st = json.load(open(os.path.join(tree, ".anchor", "state.json")))
        return st.get("state") == "done" or dn["at"] >= st["at"]
    except Exception:
        return True


def active_workers() -> list:
    agents = herdr_json("agent", "list")["agents"]
    return [a for a in agents
            if (a.get("name") or "").startswith(PREFIX) and not done_fresh(a.get("cwd") or "")]


# --- запуск одной темы ------------------------------------------------------------

def parent_workspace(repo: str) -> str:
    """Пространство оркестратора, под которым вешается тема (правило 1).

    Сначала — то, где сидит оркестратор (`HERDR_WORKSPACE_ID` в его окружении,
    очередь запускает он). Иначе — пространство основного дерева репозитория.
    Не нашли — тему не запускаем: отдельное пространство без линии хуже отказа.
    """
    wid = os.environ.get("HERDR_WORKSPACE_ID")
    if wid:
        return wid
    root = os.path.abspath(repo)
    for w in herdr_json("workspace", "list")["workspaces"]:
        if (w.get("worktree") or {}).get("checkout_path") == root:
            return w["workspace_id"]
    raise Fail(f"нет пространства оркестратора для {root}: правило 1 — тема ставится только под ним")


def make_tree(tr: dict, label: str, primary: bool):
    """Дерево и (для рабочего) панель. Возвращает pane_id свободной панели."""
    path = os.path.abspath(tr["path"])
    base = tr.get("base", "main")
    if not primary:
        if not os.path.isdir(path):
            sh("git", "-C", tr["repo"], "fetch", "-q", "origin", check=False)
            exists = subprocess.run(["git", "-C", tr["repo"], "rev-parse", "--verify", "-q", tr["branch"]],
                                    capture_output=True).returncode == 0
            sh("git", "-C", tr["repo"], "worktree", "add", "-q", path,
               *([tr["branch"]] if exists else ["-b", tr["branch"], f"origin/{base}"]))
        return None
    # Рабочее дерево — через herdr: тогда у темы есть воркспейс и её видно.
    ws = [w for w in herdr_json("workspace", "list")["workspaces"]
          if (w.get("worktree") or {}).get("checkout_path") == path]
    if not ws:
        # ПРАВИЛО 1 (SKILL.md): дерево — git'ом, пространство — `worktree open
        # --workspace <оркестратор>`. С --cwd или `worktree create` тема вставала
        # отдельным пространством в конец списка, без линии к оркестратору, и
        # человек её не находил (14.10.2026).
        if not os.path.isdir(path):
            sh("git", "-C", tr["repo"], "fetch", "-q", "origin", check=False)
            exists = subprocess.run(["git", "-C", tr["repo"], "rev-parse", "--verify", "-q", tr["branch"]],
                                    capture_output=True).returncode == 0
            sh("git", "-C", tr["repo"], "worktree", "add", "-q", path,
               *([tr["branch"]] if exists else ["-b", tr["branch"], f"origin/{base}"]))
        r = herdr_json("worktree", "open", "--workspace", parent_workspace(tr["repo"]),
                       "--path", path, "--label", label, "--no-focus", "--trust-repository")
        return r["root_pane"]["pane_id"]
    # Воркспейс пережил агента (рестарт сервера) — второй панели не делим:
    # два агента в одном дереве — то, от чего спасает каталог на тему.
    panes = herdr_json("pane", "list", "--workspace", ws[0]["workspace_id"])["panes"]
    if any(p.get("agent") for p in panes):
        raise Fail(f"в {path} уже работает агент")
    return panes[0]["pane_id"]


def worker_env(t: dict) -> dict:
    """Окружение воркера — одно для Claude (settings.local.json) и Codex (-c)."""
    env = {}
    repo = t["trees"][0]["repo"]
    beads = t.get("beads_dir") or (os.path.join(repo, ".beads") if os.path.isdir(os.path.join(repo, ".beads")) else "")
    if beads:
        env["BEADS_DIR"] = os.path.abspath(beads)
        # bd в дереве не поднимает свой Dolt-сервер (18.10.2026: 79 осиротевших
        # sql-server от убранных деревьев). С верным BEADS_DIR он ходит в сервер
        # основного дерева; с неверным — пусть падает громко, а не плодит процессы.
        env["BEADS_DOLT_AUTO_START"] = "0"
    # Родитель — машинно, а не только текстом роли: по нему anchor-status --mine
    # находит сданные деревья. Своя переменная, не ANCHOR_ORCHESTRATOR: у воркера,
    # который сам заводит воркеров, та значит «моё имя как оркестратора».
    env["ANCHOR_PARENT"] = t["orchestrator"]
    return env


def write_settings(t: dict, tree: str) -> None:
    """Локальные настройки дерева — ДО старта: читаются при запуске сессии."""
    d = os.path.join(tree, ".claude")
    os.makedirs(d, exist_ok=True)
    p = os.path.join(d, "settings.local.json")
    try:
        cfg = json.load(open(p))
        assert isinstance(cfg, dict)
    except Exception:
        cfg = {}
    cfg.setdefault("env", {}).update(worker_env(t))
    plugins = cfg.setdefault("enabledPlugins", {})
    for name in t.get("disable_plugins", PLUGINS_OFF):
        plugins[name] = False
    cfg["enabledMcpjsonServers"] = []
    extra = [os.path.abspath(tr["path"]) for tr in t["trees"][1:]]
    if extra:
        perms = cfg.setdefault("permissions", {})
        perms["additionalDirectories"] = sorted(set(perms.get("additionalDirectories", []) + extra))
    hooks = cfg.setdefault("hooks", {}).setdefault("PreToolUse", [])
    if not any(h.get("command") == GUARD for m in hooks for h in m.get("hooks", [])):
        hooks.append({"matcher": "*", "hooks": [{"type": "command", "command": GUARD}]})
    # Счёт ловушек Bash (потерянный код возврата в конвейере, голый stash pop):
    # только воркеры и только счёт — решение владельца 19.10.2026, см. bash-pitfalls.
    pitfalls = os.path.join(HERE, "bash-pitfalls")
    if os.access(pitfalls, os.X_OK) and not any(
            h.get("command") == pitfalls for m in hooks for h in m.get("hooks", [])):
        hooks.append({"matcher": "Bash", "hooks": [{"type": "command", "command": pitfalls}]})
    with open(p, "w") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)
        f.write("\n")
    # Отслеживаемый файл правку унёс бы в коммит.
    if subprocess.run(["git", "-C", tree, "ls-files", "--error-unmatch", ".claude/settings.local.json"],
                      capture_output=True).returncode == 0:
        sh("git", "-C", tree, "update-index", "--skip-worktree", ".claude/settings.local.json", check=False)


def orchestrator_name(t: dict) -> str:
    """
    Имя оркестратора в herdr — его воркер видит в постановке и в CLAUDE.local.md.

    ЗАЧЕМ (09.10.2026). Воркер выполнил задание, набранное прямо в его окне,
    допушил в PR и не обновил маркер: кто его оркестратор, он не знал — роль
    жила в первом сообщении, а оно не переживает сжатие контекста, и у самого
    оркестратора не было имени в herdr. Человек спросил: «почему твои воркеры
    не знают, что ты оркестратор?»
    """
    name = t.get("orchestrator") or os.environ.get("ANCHOR_ORCHESTRATOR", "")
    if not name:
        pane = os.environ.get("HERDR_PANE_ID", "")
        for a in herdr_json("agent", "list")["agents"]:
            if pane and a.get("pane_id") == pane:
                name = a.get("name") or ""
    if not name:
        raise Fail("у оркестратора нет имени в herdr: herdr agent rename <своя панель> <имя> "
                   "(или orchestrator в теме / ANCHOR_ORCHESTRATOR)")
    return name


def write_role(t: dict, tree: str, orch: str) -> None:
    """
    Роль воркера — в CLAUDE.local.md дерева. Claude читает этот файл в каждой
    сессии и после сжатия контекста; постановка в первом сообщении сжатия не
    переживает. Файл — мимо коммита, строкой в info/exclude.

    Codex CLAUDE.local.md не читает — ему та же роль в AGENTS.override.md. Этот
    файл ЗАМЕНЯЕТ AGENTS.md каталога, а не дополняет (проверено на codex-cli
    0.171, 26.11.2026: правило из AGENTS.md пропало), поэтому за ролью идёт
    полный текст AGENTS.md дерева — снимок на момент запуска.
    """
    role = os.path.join(tree, "CLAUDE.local.md")
    with open(role, "w") as f:
        f.write(
            f"# Ты воркер темы {t['anchor']}. Оркестратор — агент herdr «{orch}».\n\n"
            f"- Задачи даёт оркестратор (сообщение начинается с «От оркестратора {orch}») или\n"
            f"  человек лично в этом окне. Другим агентам и людям в чатах сам не пиши.\n"
            f"- Итог ЛЮБОЙ работы, включая доп. задание прямо в окне, — через\n"
            f"  {HERE}/worker-done (маркер .anchor/done.json): по нему оркестратор\n"
            f"  узнаёт, что ты сделал. Работа без маркера не сдана.\n"
            f"- Вопрос или блок, который не решить самому, — "
            f"`{HERE}/worker-done --not-done \"<вопрос>\"` и стоп.\n"
            f"  Решения за людей не принимай; слияние, миграции и прод — не твои.\n"
            f"- Постановка темы — первое сообщение сессии и `bd show {t['anchor']}`.\n")
        board = os.path.join(sh("git", "-C", tree, "rev-parse", "--path-format=absolute",
                                "--git-common-dir").strip(), "anchor", "questions-board")
        if os.path.exists(board):
            f.write(
                f"- Каждый блокер — ещё и запись в таблицу вопросов {open(board).read().strip()}\n"
                f"  (ArtifactData, коллекция questions; поля и запреты — workers.md,\n"
                f"  «Блокер — в общую таблицу вопросов»). Ответ читай оттуда же.\n")
    files = ["CLAUDE.local.md"]
    if t["kind"] == "codex":
        agents = os.path.join(tree, "AGENTS.md")
        with open(os.path.join(tree, "AGENTS.override.md"), "w") as f:
            f.write(open(role).read())
            if os.path.isfile(agents):
                f.write("\n---\n\n" + open(agents).read())
        files.append("AGENTS.override.md")
    if t["kind"] == "agy":
        # agy читает и AGENTS.md, и GEMINI.md каталога, вместе (проверено на
        # agy 1.5.16, 26.11.2026) — роль ложится рядом, без копии AGENTS.md.
        # Отслеживаемый GEMINI.md затёрли бы и унесли в коммит — отказ.
        if subprocess.run(["git", "-C", tree, "ls-files", "--error-unmatch", "GEMINI.md"],
                          capture_output=True).returncode == 0:
            raise Fail(f"{tree}/GEMINI.md в git — роль agy-воркеру положить некуда")
        shutil.copyfile(role, os.path.join(tree, "GEMINI.md"))
        files.append("GEMINI.md")
    ex = os.path.join(sh("git", "-C", tree, "rev-parse", "--path-format=absolute", "--git-common-dir").strip(),
                      "info", "exclude")
    have = open(ex).read().split("\n") if os.path.exists(ex) else []
    for name in files:
        if name not in have:
            os.makedirs(os.path.dirname(ex), exist_ok=True)
            with open(ex, "a") as f:
                f.write(name + "\n")


def toml_str(v: str) -> str:
    # Строка TOML в двойных кавычках принимает те же экранирования, что JSON.
    return json.dumps(v, ensure_ascii=False)


def claude_args() -> list:
    # Воркеры — на Sonnet (решение человека 15.10.2026): работа воркера узкая и
    # описана задачей, а думает за всю тему оркестратор. Другую модель на один
    # запуск — ANCHOR_WORKER_MODEL (например opus); пусто — модель по умолчанию.
    model = os.environ.get("ANCHOR_WORKER_MODEL", "sonnet").strip()
    # Советник (advisor tool, 16.10.2026): воркер на Sonnet сам зовёт Opus в
    # узловых точках — перед подходом, при застревании, перед «готово». Opus
    # думает за всю тему, но платим за него только в эти моменты. Пара проверена
    # запуском `claude -p --model sonnet --advisor opus`. Выключить —
    # ANCHOR_WORKER_ADVISOR= (пусто), другая модель — ANCHOR_WORKER_ADVISOR=<имя>.
    advisor = os.environ.get("ANCHOR_WORKER_ADVISOR", "opus").strip()
    return ["--dangerously-skip-permissions",
            *(["--model", model] if model else []), *(["--advisor", advisor] if advisor else [])]


def codex_args(t: dict, tree: str, pane: str) -> list:
    """
    Ключи запуска Codex-воркера. То, что Claude-воркеру даёт settings.local.json,
    здесь — ключами -c на одну сессию: общий ~/.codex/config.toml — всех сессий
    Codex человека, его не трогаем.

    НЕ ПРОФИЛЕМ (`codex -p`, 26.11.2026). Профиль Codex проверяет как отдельный
    конфиг: запись сервера с одним `enabled = false`, без command/url, —
    ошибка, а копировать описания нельзя — в них ключи.

    MCP С КЛЮЧАМИ ВЫКЛЮЧЕНЫ: в ~/.codex/config.toml стоят supabase с полным токеном,
    railway и агентский ключ AI Office, плагины Codex добавляют свои. Воркер
    без песочницы получил бы прод напрямую, мимо ограды, которая видит только
    Bash и правки. Claude-воркеру то же делает enabledMcpjsonServers=[].

    Серверы плагинов Codex (cua_repl — управление компьютером, codex_app)
    ключом -c не выключить: записи без транспорта Codex считает ошибкой и не
    встаёт. Их убирает `--disable plugins --disable apps`. Серверы общего
    ~/.codex/config.toml — там ключи прода — выключаем по одному. Серверы из
    проектного .codex/config.toml репозитория остаются: -c пишет в слой
    пользователя, и сервер, описанный только в проекте, получает там пустую
    запись — Codex не встаёт (26.11.2026, playwright-test). Они — часть
    репозитория, как его тесты.
    Ключ -c режет путь по точкам и кавычек TOML не понимает
    (`mcp_servers."x"` — новая запись с кавычками в имени), поэтому имя
    другого вида — отказ запуска, а не тихо невыключенный сервер.
    """
    off = ["--disable", "plugins", "--disable", "apps"]
    home = os.environ.get("CODEX_HOME", os.path.join(HOME, ".codex"))
    try:
        servers = list(tomllib.load(open(os.path.join(home, "config.toml"), "rb")).get("mcp_servers", {}))
    except FileNotFoundError:
        servers = []
    bad = [n for n in servers if not re.fullmatch(r"[A-Za-z0-9_-]+", n)]
    if bad:
        raise Fail(f"MCP с именем, которое ключом -c не выключить: {bad}")
    args = ["--dangerously-bypass-approvals-and-sandbox",
            # Ограда приходит ключом -c, а не из доверенного hooks.json: без
            # этого Codex её не запустит, пока человек не одобрит хук в окне.
            "--dangerously-bypass-hook-trust", *off,
            # Свой сервер, не общий фоновый: общий один на все клиенты Codex
            # человека, и с выключенными плагинами Codex предлагает
            # перезапустить его — с plugins=false для всех (26.11.2026).
            "--no-daemon",
            # Диалог «Update now» на старте держал бы панель до человека.
            "-c", "check_for_update_on_startup=false"]
    for n in servers:
        args += ["-c", f"mcp_servers.{n}.enabled=false"]
    # Окружение — через политику Codex: по умолчанию (inherit=core) команды
    # получают только базовые переменные, экспорт в оболочке до них не дойдёт.
    env = worker_env(t)
    # herdr тоже: без HERDR_ENV=1 навык herdr запрещает `herdr agent prompt`, и
    # воркер не может сообщить оркестратору (26.11.2026, первый Codex-воркер).
    # Claude-воркер наследует их от панели, Codex их отрезает. Панель — воркера.
    for k in ("HERDR_ENV", "HERDR_SOCKET_PATH", "HERDR_BIN_PATH", "HERDR_SESSION"):
        if os.environ.get(k):
            env[k] = os.environ[k]
    env["HERDR_PANE_ID"] = pane
    env["HERDR_WORKSPACE_ID"] = pane.split(":")[0]
    for k, v in env.items():
        args += ["-c", f"shell_environment_policy.set.{k}={toml_str(v)}"]
    # Хуки PreToolUse срабатывают и без песочницы, код 2 останавливает вызов;
    # вход Bash — тот же {tool_name, tool_input.command, cwd}, правки —
    # apply_patch (их разбирает worker-guard). Проверено на codex-cli 0.171.
    hooks = [f"{{matcher=\".*\",hooks=[{{type=\"command\",command={toml_str(GUARD)}}}]}}"]
    pitfalls = os.path.join(HERE, "bash-pitfalls")
    if os.access(pitfalls, os.X_OK):
        hooks.append(f"{{matcher=\"Bash\",hooks=[{{type=\"command\",command={toml_str(pitfalls)}}}]}}")
    args += ["-c", f"hooks.PreToolUse=[{','.join(hooks)}]"]
    model = t.get("codex_model") or os.environ.get("ANCHOR_CODEX_MODEL", "").strip()
    effort = t.get("codex_effort") or os.environ.get("ANCHOR_CODEX_EFFORT", "").strip()
    if model:
        args += ["-m", model]
    if effort:
        args += ["-c", f"model_reasoning_effort={toml_str(effort)}"]
    return args


def start_codex(t: dict, tree: str, pane: str) -> None:
    """
    Codex — не через `herdr agent start`: тот печатает команду в панель, а
    ключей у Codex-воркера два десятка, строка больше предела строки терминала
    macOS (~1 КБ). 26.11.2026 herdr напечатал её обрезанной, Codex не встал.
    Поэтому ключи — в запускателе, в панель уходит `sh <запускатель>`, а herdr
    узнаёт Codex в панели сам; имя ставим rename.
    """
    d = os.path.join(HOME, ".anchor", "codex")
    os.makedirs(d, exist_ok=True)
    launcher = os.path.join(d, t["name"] + ".sh")
    with open(launcher, "w") as f:
        f.write(f"#!/bin/sh\n# Запуск Codex-воркера {t['name']} (тема {t['anchor']}) — пишет anchor-queue.\n"
                f"exec codex {' '.join(shlex.quote(a) for a in codex_args(t, tree, pane))}\n")
    sh("herdr", "pane", "run", pane, f"sh {shlex.quote(launcher)}")
    wait_kind(t, pane, "codex")


def write_agy_hooks(tree: str) -> None:
    """
    Ограда agy-воркера — .agents/hooks.json дерева: agy берёт хуки каталога
    без вопроса о доверии и вызывает их и под --dangerously-skip-permissions
    (проверено на agy 1.5.16, 26.11.2026). Общий ~/.gemini/config/hooks.json —
    всех сессий человека, его не трогаем. Файл мимо коммита; чужие хуки в
    нём сохраняются, наш — под своим именем.
    """
    d = os.path.join(tree, ".agents")
    os.makedirs(d, exist_ok=True)
    p = os.path.join(d, "hooks.json")
    try:
        cfg = json.load(open(p))
        assert isinstance(cfg, dict)
    except Exception:
        cfg = {}
    cfg["anchor-guard"] = {"PreToolUse": [{"matcher": "*", "hooks": [
        {"type": "command", "command": os.path.join(HERE, "agy-hook"), "timeout": 30}]}]}
    with open(p, "w") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)
        f.write("\n")
    if subprocess.run(["git", "-C", tree, "ls-files", "--error-unmatch", ".agents/hooks.json"],
                      capture_output=True).returncode == 0:
        sh("git", "-C", tree, "update-index", "--skip-worktree", ".agents/hooks.json", check=False)
    else:
        ex = os.path.join(sh("git", "-C", tree, "rev-parse", "--path-format=absolute",
                             "--git-common-dir").strip(), "info", "exclude")
        if ".agents/hooks.json" not in (open(ex).read().split("\n") if os.path.exists(ex) else []):
            with open(ex, "a") as f:
                f.write(".agents/hooks.json\n")


def agy_args(t: dict, tree: str) -> list:
    # MCP agy-воркеру не выключаем ключом: у agy нет ключа «без серверов», а
    # ~/.gemini/config/mcp_config.json пуст (26.11.2026). Появится там сервер
    # с ключами прода — выключать здесь, как у Codex.
    model = t.get("agy_model") or os.environ.get("ANCHOR_AGY_MODEL", "").strip()
    effort = t.get("agy_effort") or os.environ.get("ANCHOR_AGY_EFFORT", "").strip()
    # Доверие к дереву — ключом --settings на одну сессию: без него agy на
    # старте спрашивает «Do you trust the contents of this project?» и стоит
    # до человека (26.11.2026, первый запуск). Дерево завела сама очередь —
    # как с диалогом доверия Claude (решение человека 05.10.2026). Общий
    # settings.json человека не трогаем: --settings в него не пишет.
    trust = {"trustedWorkspaces": [os.path.abspath(tr["path"]) for tr in t["trees"]]}
    return ["--dangerously-skip-permissions", "--settings", json.dumps(trust, ensure_ascii=False),
            *(["--model", model] if model else []), *(["--effort", effort] if effort else [])]


def start_agy(t: dict, tree: str, pane: str) -> None:
    """
    agy — тем же запускателем, что Codex: окружение воркера экспортом (команды
    agy наследуют окружение процесса — проверено), herdr узнаёт agy в панели сам.
    """
    write_agy_hooks(tree)
    d = os.path.join(HOME, ".anchor", "agy")
    os.makedirs(d, exist_ok=True)
    launcher = os.path.join(d, t["name"] + ".sh")
    with open(launcher, "w") as f:
        f.write(f"#!/bin/sh\n# Запуск agy-воркера {t['name']} (тема {t['anchor']}) — пишет anchor-queue.\n")
        for k, v in worker_env(t).items():
            f.write(f"export {k}={shlex.quote(v)}\n")
        f.write(f"exec agy {' '.join(shlex.quote(a) for a in agy_args(t, tree))}\n")
    sh("herdr", "pane", "run", pane, f"sh {shlex.quote(launcher)}")
    wait_kind(t, pane, "agy")


def wait_kind(t: dict, pane: str, kind: str) -> None:
    for _ in range(60):
        time.sleep(2)
        for a in herdr_json("agent", "list")["agents"]:
            if a.get("pane_id") == pane and a.get("agent") == kind:
                if a.get("name") != t["name"]:
                    sh("herdr", "agent", "rename", pane, t["name"])
                return
    screen = sh("herdr", "pane", "read", pane, "--source", "recent-unwrapped", "--lines", "15", check=False)
    raise Fail(f"{kind} не встал в {pane} за 120 с: {screen.strip()[-300:]}")


def prompt_text(t: dict, tree: str) -> str:
    body = t.get("prompt") or open(t["prompt_file"]).read()
    # Хвост одинаков у всех тем — признак готовности задаёт оркестратор заранее,
    # а не выводит из ответа воркера (SKILL, «Когда считать сделанным»).
    return (f"От оркестратора {t['orchestrator']}.\n\n{body.strip()}\n\n"
            f"Состояние отмечай: {HERE}/worker-state working|waiting|stuck \"<причина>\" "
            f"(waiting — когда ждёшь фоновую команду, лимит или ответ; это не застрял).\n"
            f"Тесты и сборку — через {HERE}/heavy.\n"
            f"Свой зелёный PR сливаешь сам: влей свежий origin/main (git merge), прогон тестов и сторожей "
            f"зелёный — тогда gh pr merge. Миграцию применяешь сам: копия базы (sh scripts/db_backup.sh <метка>), "
            f"сверка текущих ограничений, применение через сессионный порт 5432, проверка после. "
            f"Прод: переменные и vercel — не твои. Деплой можно только сервисам из ~/.anchor/deploy_allow и только слитого: "
            f"после слияния переведи своё серверное дерево на свежий main (git fetch origin && git checkout --detach origin/main), "
            f"затем одной командой railway up <дерево> --path-as-root --service <сервис> --detach; дождись SUCCESS и строки запуска в логах.\n"
            f"Закончил — {HERE}/worker-done \"<что сделано и чем проверено>\" "
            f"(не сделал — с --not-done и причиной). Без этого работа не считается сданной.")


def start(t: dict) -> str:
    if not os.access(GUARD, os.X_OK):
        raise Fail(f"нет ограды {GUARD} — без неё --dangerously-skip-permissions не включаем")
    t["orchestrator"] = orchestrator_name(t)
    names = {a.get("name") for a in herdr_json("agent", "list")["agents"]}
    if t["name"] in names:
        raise Fail(f"агент {t['name']} уже есть")
    tree = os.path.abspath(t["trees"][0]["path"])
    for tr in t["trees"][1:]:
        make_tree(tr, t["label"], primary=False)
    # Настройки пишем после дерева, но до агента. Для нового дерева это значит:
    # create заводит каталог, и сразу же — файл.
    pane = make_tree(t["trees"][0], t["label"], primary=True)
    write_settings(t, tree)
    for tr in t["trees"]:
        write_role(t, os.path.abspath(tr["path"]), t["orchestrator"])
    # Ссылки на окружение — мимо коммита, как и маркеры: воркер с `git add -A`
    # иначе унесёт в PR ссылку на чужой node_modules.
    ex = os.path.join(sh("git", "-C", tree, "rev-parse", "--path-format=absolute", "--git-common-dir").strip(),
                      "info", "exclude")
    have = open(ex).read().split("\n") if os.path.exists(ex) else []
    for name, src in (t.get("links") or {}).items():
        dst = os.path.join(tree, name)
        if not os.path.lexists(dst):
            os.symlink(src, dst)
        if f"/{name}" not in have:
            os.makedirs(os.path.dirname(ex), exist_ok=True)
            with open(ex, "a") as f:
                f.write(f"/{name}\n")

    if t["kind"] in ("codex", "agy"):
        (start_codex if t["kind"] == "codex" else start_agy)(t, tree, pane)
        r = subprocess.CompletedProcess([], 0)
    else:
        r = subprocess.run(["herdr", "agent", "start", t["name"], "--kind", "claude", "--pane", pane,
                            "--", *claude_args()], capture_output=True, text=True)
    if r.returncode != 0:
        if "agent_not_ready" not in (r.stderr + r.stdout):
            raise Fail(f"agent start: {(r.stderr or r.stdout).strip()[:300]}")
        # Ложный отказ: Claude жив, на старте диалог доверия к папке. Дерево
        # завела сама очередь из репозитория оркестратора — отвечает он
        # (решение человека 05.10.2026). Чужие каталоги так не открывают.
        screen = sh("herdr", "pane", "read", pane, "--source", "recent-unwrapped", "--lines", "40", check=False)
        if re.search(r"trust (this|the) folder", screen, re.I):
            sh("herdr", "pane", "send-keys", pane, "Down", "Enter")
            time.sleep(3)
        agents = herdr_json("agent", "list")["agents"]
        if not any(a.get("name") == t["name"] for a in agents):
            sh("herdr", "agent", "rename", pane, t["name"])
    # Промпт — только готовому агенту; иначе он уйдёт в недорисованный экран.
    sh("herdr", "agent", "wait", t["name"], "--until", "idle", "--timeout", "120000")
    sh("herdr", "agent", "prompt", t["name"], prompt_text(t, tree))
    return tree


# --- команды ------------------------------------------------------------------------

def cmd_add(path: str) -> None:
    t = load_topic(path)
    d = dirs()
    dst = os.path.join(d["pending"], f"{datetime.datetime.now():%Y%m%d-%H%M%S}-{t['anchor']}.json")
    shutil.copy(path, dst)
    n = len(os.listdir(d["pending"]))
    print(f"в очереди: {t['anchor']} ({n}-я) → {dst}")


def cmd_list() -> None:
    d = dirs()
    for k, title in (("pending", "ждут"), ("started", "запущены"), ("failed", "не встали")):
        items = sorted(os.listdir(d[k]))
        print(f"{title}: {len(items)}")
        for f in items[-10:]:
            print(f"  {f}")


def cmd_run(once: bool) -> None:
    d = dirs()
    lock = open(os.path.join(QDIR, "run.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("anchor-queue: run уже идёт — он подберёт и новое")
        return
    said = False
    while True:
        pending = sorted(os.listdir(d["pending"]))
        if not pending:
            log("очередь пуста")
            return
        try:
            busy = active_workers()
        except Fail as e:
            log(f"herdr не ответил ({e}) — жду")
            time.sleep(POLL)
            continue
        if len(busy) >= MAX:
            if not said:
                log(f"заняты {len(busy)} из {MAX}: {', '.join(a['name'] for a in busy)} — жду места")
                said = True
            time.sleep(POLL)
            continue
        said = False
        f = pending[0]
        src = os.path.join(d["pending"], f)
        try:
            t = load_topic(src)
            tree = start(t)
            os.replace(src, os.path.join(d["started"], f))
            log(f"ЗАПУЩЕН {t['name']} в {tree} — ждать: {HERE}/worker-done --wait {tree}")
            if once:
                return
        except Fail as e:
            # Не встала — в сторону с причиной, очередь не держим: следующая
            # тема не виновата. Повторить — `add` заново после правки.
            os.replace(src, os.path.join(d["failed"], f))
            with open(os.path.join(d["failed"], f + ".err"), "w") as fe:
                fe.write(str(e) + "\n")
            log(f"НЕ ВСТАЛА {f}: {e}")


def main() -> None:
    a = sys.argv[1:]
    try:
        if a[:1] == ["add"] and len(a) == 2:
            cmd_add(a[1])
        elif a[:1] == ["list"]:
            cmd_list()
        elif a[:1] == ["run"] and a[1:] in ([], ["--once"]):
            cmd_run(once=a[1:] == ["--once"])
        else:
            print(__doc__.strip())
            sys.exit(0 if a[:1] in ([], ["-h"], ["--help"]) else 2)
    except Fail as e:
        sys.exit(f"anchor-queue: {e}")


if __name__ == "__main__":
    main()
